rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function admin(workspace) {
      return verified()
        && get(/databases/$(database)/documents/workspaces/$(workspace)/access/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/workspaces/$(workspace)/access/$(request.auth.uid)).data.role == 'admin';
    }
    function afterHead(workspace) {
      return getAfter(/databases/$(database)/documents/workspaces/$(workspace)/state/head).data;
    }
    match /workspaces/{workspace}/access/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /workspaces/{workspace}/profiles/{uid} {
      allow read: if admin(workspace) && request.auth.uid == uid;
      allow create, update: if admin(workspace) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /workspaces/{workspace}/state/{stateId} {
      allow read: if stateId == 'head' && admin(workspace);
      allow create, update: if stateId == 'head' && admin(workspace)
        && request.resource.data.keys().hasOnly(['schemaVersion','revision','generation','chunkCount','bytes','updatedAt','updatedBy'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.generation is string
        && request.resource.data.generation.size() >= 10 && request.resource.data.generation.size() <= 100
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0 && request.resource.data.chunkCount <= 88
        && request.resource.data.bytes is int
        && request.resource.data.bytes > 0 && request.resource.data.bytes <= 4194304
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /workspaces/{workspace}/blocks/{blockId} {
      allow read: if admin(workspace);
      allow create, update: if admin(workspace)
        && request.resource.data.keys().hasOnly(['generation','index','payload'])
        && request.resource.data.index is int
        && request.resource.data.index >= 0 && request.resource.data.index < afterHead(workspace).chunkCount
        && blockId == 'b' + string(request.resource.data.index)
        && request.resource.data.generation == afterHead(workspace).generation
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 192000
        && afterHead(workspace).updatedAt == request.time;
      allow delete: if admin(workspace)
        && resource.data.index >= afterHead(workspace).chunkCount
        && afterHead(workspace).updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
